{
  "name": "drafts-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Streamable HTTP bridge for the @agiletortoise/drafts-mcp-server stdio MCP server.",
  "bin": {
    "drafts-mcp-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:release": "node scripts/build-release.mjs",
    "dev": "tsx src/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "launchd:install": "scripts/install-launch-agent.sh",
    "launchd:logs": "scripts/tail-launch-agent-logs.sh",
    "launchd:uninstall": "scripts/uninstall-launch-agent.sh",
    "lint": "biome lint .",
    "start": "scripts/run-server.sh",
    "start:tailscale": "scripts/run-tailscale.sh",
    "test": "vitest run",
    "token:generate": "scripts/generate-token.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agiletortoise/drafts-mcp-server": "1.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "18.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.28.0"
}
