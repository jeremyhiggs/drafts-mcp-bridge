# .env is optional. These are the built-in defaults.
# Run `pnpm token:generate` to create ~/.config/drafts-mcp-bridge/token (or use XDG_CONFIG_HOME).
# The application directory is 0700; the token file is 0600.
# DRAFTS_MCP_TOKEN_FILE=/absolute/path/to/a/private/token
# DRAFTS_MCP_HOST=127.0.0.1
# DRAFTS_MCP_PORT=3060
# DRAFTS_MCP_READ_ONLY=true
# DRAFTS_MCP_VERBOSE=false
# DRAFTS_MCP_TAILSCALE_SERVE=false
